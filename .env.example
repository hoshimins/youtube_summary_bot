# データベース接続
DATABASE_URL=postgresql://user:password@host:5432/database

# YouTube Data API v3（all モード・id モードで必要。latest モードは不要）
YOUTUBE_API_KEY=your_youtube_api_key

# 要約プロバイダー（codex / openai / lmstudio、デフォルト: codex）
# 自宅サーバーではホストにインストール済みの Codex CLI を使う
SUMMARY_PROVIDER=codex

# Codex CLI（SUMMARY_PROVIDER=codex のとき使用）
CODEX_BIN=codex
# 任意。未設定なら Codex 側のデフォルトモデル
# CODEX_MODEL=gpt-5.4
# 要約タイムアウト秒（デフォルト: 600）
CODEX_TIMEOUT=600
# 1回の summarize で処理する最大件数（0 で無制限、デフォルト: 3）
SUMMARIZE_BATCH_LIMIT=3

# LM Studio（SUMMARY_PROVIDER=lmstudio のとき使用）
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=your_model_name

# OpenAI Chat Completions（SUMMARY_PROVIDER=openai のとき使用）
OPENAI_API_KEY=your_openai_api_key

# Discord Webhook
WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx
# Webhook 送信時は未使用。将来の Bot 化用に保持
SUMMARY_TEXT_CHANNEL_ID=0

# 失敗通知（ntfy）。未設定なら通知しない
# 例: https://ntfy.example.com/youtube-summary-bot
NTFY_URL=
# 任意。サーバ側で認証が必要な場合
NTFY_TOKEN=

# 字幕設定
# 取得する字幕言語（カンマ区切りで優先順、デフォルト: en）
CAPTION_LANGUAGES=en
# 字幕取得リクエスト間の待機秒数（レート制限対策、デフォルト: 30）
CAPTION_SLEEP_INTERVAL=30
# DB 保存・要約前の字幕最大文字数（デフォルト: 100000）
CAPTION_MAX_CHARS=100000
