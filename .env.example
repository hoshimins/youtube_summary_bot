# データベース接続
DATABASE_URL=postgresql://user:password@host:5432/database

# YouTube Data API v3（all モード・id モードで必要。latest モードは不要）
YOUTUBE_API_KEY=your_youtube_api_key

# 要約プロバイダー設定（lmstudio または openai、デフォルト: lmstudio）
SUMMARY_PROVIDER=lmstudio

# LM Studio（SUMMARY_PROVIDER=lmstudio のとき使用）
LM_STUDIO_BASE_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=your_model_name

# OpenAI（SUMMARY_PROVIDER=openai のとき使用）
OPENAI_API_KEY=your_openai_api_key

# Discord Webhook
WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# 字幕設定
# 取得する字幕言語（カンマ区切りで優先順に指定、デフォルト: ja）
CAPTION_LANGUAGES=ja
# 字幕取得リクエスト間の待機秒数（レート制限対策、デフォルト: 30）
CAPTION_SLEEP_INTERVAL=30
